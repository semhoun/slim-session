{
  "name": "@semhoun/slim-session",
  "version": "0.1.0",
  "description": "Framework-independent server-side session browser client",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./slim-session.js": "./dist/slim-session.js", "./slim-session.min.js": "./dist/slim-session.min.js" },
  "files": ["dist"],
  "scripts": {
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
