{
  "name": "semhoun/slim-session",
  "description": "Server-backed sessions with atomic lifecycle guarantees",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "lcobucci/jwt": "^5.5",
    "psr/clock": "^1.0",
    "psr/http-message": "^2.0",
    "psr/http-server-middleware": "^1.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "nyholm/psr7": "^1.8"
  },
  "autoload": {"psr-4": {"Semhoun\\SlimSession\\": "src/"}},
  "autoload-dev": {"psr-4": {"Semhoun\\SlimSession\\Tests\\": "tests/"}},
  "scripts": {"test": "phpunit", "analyse": "phpstan analyse"},
  "config": {"platform": {"php": "8.3.0"}, "sort-packages": true}
}
